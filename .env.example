# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# JWT 签名密钥：必须自行生成，长度 >= 32 字符。生成方式：
#   ./.venv/Scripts/python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=

# 以下为可选覆盖项，留空则使用 config.yaml 中的默认值
# APP_ENV=prod
# APP_HOST=0.0.0.0
# APP_PORT=8000
# OLLAMA_BASE_URL=http://127.0.0.1:11434
